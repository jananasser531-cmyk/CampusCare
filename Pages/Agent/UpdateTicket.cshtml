@page "/Agent/UpdateTicket"
@using CampusCare.Frontend.SampleData
@{ var id=HttpContext.Request.Query["ticket"].ToString(); var ticket=DemoData.Tickets.FirstOrDefault(t=>t.Number==id) ?? DemoData.Tickets[0]; var history=DemoData.Activity.TryGetValue(ticket.Number,out var events)?events:Array.Empty<TicketActivity>(); var overdue=ticket.Status!="Resolved"&&ticket.Status!="Closed"&&ticket.SlaDueOn<DateTime.UtcNow; ViewData["Title"]="Update Ticket"; }
<div class="page-heading"><div><p class="eyebrow">AGENT WORKSPACE / @ticket.Number</p><h1>Update Ticket</h1><p class="page-intro">Review the ticket and prepare an update. Sample changes stay in this browser.</p></div><span class="data-badge">Sample ticket</span></div>
<div class="detail-layout"><div><section class="cc-panel ticket-summary"><div class="cc-panel__header"><h2 class="cc-panel__title">@ticket.Number · @ticket.Subject</h2><span class="cc-tag cc-tag--@ticket.Priority.ToLowerInvariant()">@ticket.Priority priority</span></div><div class="cc-panel__body"><dl class="detail-list"><div><dt>Status</dt><dd><span class="status-chip">@ticket.Status</span></dd></div><div><dt>Category</dt><dd>@ticket.Category</dd></div><div><dt>Location</dt><dd>@ticket.Location</dd></div><div><dt>Submitted</dt><dd>@DemoData.DisplayDate(ticket.SubmittedOn)</dd></div><div><dt>Updated</dt><dd>@DemoData.DisplayDate(ticket.UpdatedOn)</dd></div><div><dt>Requester</dt><dd>@ticket.Requester</dd></div><div><dt>Assigned agent</dt><dd>@ticket.Agent</dd></div></dl><h3>Description</h3><p>@ticket.Description</p><div class="sla-card @(overdue?"overdue":"within")"><strong>@(overdue?"Sample SLA overdue":"Within sample SLA")</strong><span>48-hour illustrative threshold · due @DemoData.DisplayDate(ticket.SlaDueOn)</span></div></div></section>
<section class="cc-panel activity-panel"><div class="cc-panel__header"><h2 class="cc-panel__title">Ticket activity</h2><span class="cc-text-caption cc-text-muted">Sample timeline</span></div><ol class="activity-timeline">@foreach(var item in history.OrderByDescending(x=>x.At)){<li class="activity-entry"><span class="activity-marker" aria-hidden="true"></span><div><div class="activity-meta"><strong>@item.Kind</strong><time datetime="@item.At.ToString("o")">@DemoData.DisplayDate(item.At)</time></div><p>@item.Text</p><small>@item.Actor@(item.Internal?" · staff only":"")</small></div></li>}</ol>@if(history.Length==0){<div class="cc-empty"><p class="cc-empty__title">No activity history in this sample</p></div>}</section></div>
<section class="cc-panel"><div class="cc-panel__header"><h2 class="cc-panel__title">Update ticket</h2></div><div class="cc-panel__body"><div class="cc-validation-summary" role="alert" tabindex="-1" data-validation-summary hidden><p class="cc-validation-summary__title">Please review the form</p><ul data-error-list></ul></div><form data-demo-form><input type="hidden" id="selected-ticket" value="@ticket.Number"/><div class="cc-field"><label class="form-label" for="ticket-status">Status</label><select class="form-select" id="ticket-status">@foreach(var status in DemoData.Statuses){<option selected="@(ticket.Status==status)">@status</option>}</select></div><div class="cc-field"><label class="form-label" for="public-comment">Public comment</label><textarea class="form-control" id="public-comment" rows="4" placeholder="Visible to requester"></textarea><div class="cc-field__hint">Visible to the requester.</div></div><div class="cc-field internal-field"><label class="form-label" for="internal-note">Staff-only internal note</label><textarea class="form-control" id="internal-note" rows="3" placeholder="For staff only"></textarea><div class="cc-field__hint">Only for staff; separate from the public comment.</div></div><div class="cc-field"><label class="form-label" for="resolution-summary">Resolution summary <span class="cc-optional">(required when marking resolved)</span></label><textarea class="form-control" id="resolution-summary" rows="3" placeholder="Describe work completed"></textarea></div><div class="form-actions"><button class="btn btn-primary" type="submit">Preview changes</button><span class="cc-text-caption cc-text-muted">Temporary page preview · not saved</span></div></form></div></section></div>

