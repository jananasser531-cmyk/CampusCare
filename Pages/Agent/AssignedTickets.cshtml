@page "/Agent/AssignedTickets"
@using CampusCare.Frontend.SampleData
@{ var agentTickets=DemoData.Tickets.Where(t=>t.Agent==DemoData.SampleAgent).ToArray(); ViewData["Title"]="Assigned Tickets"; }
<div class="page-heading"><div><p class="eyebrow">AGENT WORKSPACE</p><h1>Assigned Tickets</h1><p class="page-intro">Tickets assigned to @DemoData.SampleAgent. All records and dates are illustrative.</p></div><span class="data-badge">Sample data</span></div>
<section class="stats-grid" aria-label="Ticket summary"><article class="cc-panel stat-card"><span>Assigned to you</span><strong>@agentTickets.Length</strong></article>@foreach(var status in new[]{"Open","In progress","Waiting for requester"}){<article class="cc-panel stat-card"><span>@status</span><strong>@agentTickets.Count(t=>t.Status==status)</strong></article>}</section>
<section class="cc-panel list-panel"><div class="panel-toolbar"><div><h2 class="cc-panel__title">Your tickets</h2><p class="cc-text-dense cc-text-muted mb-0">Filtered to the current sample agent: @DemoData.SampleAgent</p></div><label class="search-box"><span class="cc-visually-hidden">Search assigned tickets</span><svg class="cc-icon" aria-hidden="true"><use href="/img/campuscare/icons.svg#cc-search"/></svg><input type="search" placeholder="Search tickets" data-table-search="assigned-table"/></label></div>
<div class="cc-table-wrap"><table class="cc-table responsive-table" id="assigned-table"><caption class="cc-visually-hidden">Tickets assigned to @DemoData.SampleAgent</caption><thead><tr><th>Ticket</th><th>Subject</th><th>Priority</th><th>Status</th><th>Submitted</th><th>SLA sample</th><th><span class="cc-visually-hidden">Action</span></th></tr></thead><tbody>@foreach(var t in agentTickets){var late=t.Status!="Resolved"&&t.Status!="Closed"&&t.SlaDueOn<DateTime.UtcNow; <tr><td data-label="Ticket"><a class="cc-ticket-id" href="/Agent/UpdateTicket?ticket=@t.Number">@t.Number</a></td><td data-label="Subject"><strong>@t.Subject</strong><small class="row-sub">@t.Category</small></td><td data-label="Priority"><span class="cc-tag cc-tag--@t.Priority.ToLowerInvariant()">@t.Priority</span></td><td data-label="Status"><span class="status-chip">@t.Status</span></td><td data-label="Submitted">@DemoData.DisplayDate(t.SubmittedOn)</td><td data-label="SLA sample"><span class="sla-chip @(late?"overdue":"within")">@(late?"Overdue":"Due "+DemoData.DisplayDate(t.SlaDueOn))</span></td><td data-label="Action"><a class="btn btn-secondary btn-sm" href="/Agent/UpdateTicket?ticket=@t.Number">Update</a></td></tr>}</tbody></table></div><div class="cc-empty" data-empty hidden><p class="cc-empty__title">No matching tickets</p><p class="cc-empty__hint">Try a different search term.</p></div></section>
