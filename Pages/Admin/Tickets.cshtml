@page "/Admin/Tickets"
@using CampusCare.Frontend.SampleData
@{ ViewData["Title"]="All Tickets"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATOR WORKSPACE</p><h1>All Tickets</h1><p class="page-intro">Review each illustrative maintenance ticket and preview agent assignment.</p></div><span class="data-badge">Sample records · no persistence</span></div>
<section class="cc-panel filters-panel"><h2 class="cc-panel__title">Search and filter</h2><div class="filters-grid"><label>Search<input class="form-control" type="search" placeholder="Ticket number or subject" data-filter="search"/></label><label>Status<select class="form-select" data-filter="status"><option value="">All statuses</option>@foreach(var x in DemoData.Statuses){<option>@x</option>}</select></label><label>Category<select class="form-select" data-filter="category"><option value="">All categories</option>@foreach(var x in DemoData.Categories){<option>@x</option>}</select></label><label>Priority<select class="form-select" data-filter="priority"><option value="">All priorities</option>@foreach(var x in DemoData.Priorities){<option>@x</option>}</select></label><label>Assigned agent<select class="form-select" data-filter="agent"><option value="">All agents</option>@foreach(var x in DemoData.Agents){<option>@x</option>}</select></label><label>Submitted date<input class="form-control" type="date" data-filter="date"/></label></div><button class="btn btn-link btn-sm" type="button" data-clear-filters>Clear filters</button></section>
<section class="cc-panel list-panel"><div class="panel-toolbar"><div><h2 class="cc-panel__title">Ticket queue</h2><p class="cc-text-dense cc-text-muted mb-0"><span data-result-count>@DemoData.Tickets.Length</span> sample tickets</p></div><label class="page-size-label">Rows <select class="form-select" data-page-size aria-label="Rows per page"><option>5</option><option>10</option><option>20</option></select></label></div><div class="cc-table-wrap"><table class="cc-table responsive-table" id="admin-tickets"><caption class="cc-visually-hidden">All sample tickets</caption><thead><tr><th>Ticket / subject</th><th>Category</th><th>Priority</th><th>Status</th><th>Assigned agent</th><th>Submitted</th><th>SLA sample</th><th>Actions</th></tr></thead><tbody>@foreach(var t in DemoData.Tickets){<tr data-ticket="@t.Number" data-number="@t.Number" data-subject="@t.Subject" data-description="@t.Description" data-requester="@t.Requester" data-location="@t.Location" data-category="@t.Category" data-priority="@t.Priority" data-status="@t.Status" data-agent="@t.Agent" data-submitted="@DemoData.DisplayDate(t.SubmittedOn)" data-updated="@DemoData.DisplayDate(t.UpdatedOn)" data-due="@DemoData.DisplayDate(t.SlaDueOn)" data-submitted-date="@t.SubmittedOn.ToString("yyyy-MM-dd")" data-activity='@System.Text.Json.JsonSerializer.Serialize(DemoData.Activity.TryGetValue(t.Number,out var activity)?activity:Array.Empty<TicketActivity>())'><td data-label="Ticket / subject"><button type="button" class="table-link" data-details>@t.Number · @t.Subject</button><small class="row-sub">@t.Requester</small></td><td data-label="Category">@t.Category</td><td data-label="Priority"><span class="cc-tag cc-tag--@t.Priority.ToLowerInvariant()">@t.Priority</span></td><td data-label="Status">@t.Status</td><td data-label="Assigned agent" data-assignee>@t.Agent</td><td data-label="Submitted">@DemoData.DisplayDate(t.SubmittedOn)</td><td data-label="SLA sample"><span class="sla-chip @((t.Status!="Resolved"&&t.Status!="Closed"&&t.SlaDueOn<DateTime.UtcNow)?"overdue":"within")">@((t.Status!="Resolved"&&t.Status!="Closed"&&t.SlaDueOn<DateTime.UtcNow)?"Overdue":"Due "+DemoData.DisplayDate(t.SlaDueOn))</span></td><td data-label="Actions"><button type="button" class="btn btn-secondary btn-sm" data-assign>Assign / reassign</button></td></tr>}</tbody></table></div><div class="cc-empty" data-empty hidden><p class="cc-empty__title">No tickets match these filters</p><p class="cc-empty__hint">Adjust or clear the current filters.</p></div><nav class="table-pagination" aria-label="Ticket pagination"><span data-page-label></span><div><button class="btn btn-secondary btn-sm" type="button" data-page-prev>Previous</button><button class="btn btn-secondary btn-sm" type="button" data-page-next>Next</button></div></nav></section>
<dialog class="cc-dialog" id="ticket-dialog" aria-labelledby="ticket-dialog-title"><div class="dialog-head"><h2 id="ticket-dialog-title">Ticket details</h2><button type="button" class="icon-button" data-close-dialog aria-label="Close details">×</button></div><div class="dialog-content" data-dialog-content></div></dialog>
<dialog class="cc-dialog" id="assign-dialog" aria-labelledby="assign-dialog-title"><div class="dialog-head"><h2 id="assign-dialog-title">Assign or reassign agent</h2><button type="button" class="icon-button" data-close-dialog aria-label="Close assignment dialog">×</button></div><div class="dialog-content"><p data-assign-ticket></p><label class="form-label" for="agent-select">Assigned agent</label><select class="form-select" id="agent-select">@foreach(var a in DemoData.Agents){<option>@a</option>}</select><p class="cc-field__hint">This changes only the current page preview.</p><div class="form-actions"><button class="btn btn-primary" type="button" data-save-assignment>Preview assignment</button><button class="btn btn-secondary" type="button" data-cancel-dialog>Cancel</button></div></div></dialog>


