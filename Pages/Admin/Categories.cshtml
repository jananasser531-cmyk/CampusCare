@page "/Admin/Categories"
@using CampusCare.Frontend.SampleData
@{ ViewData["Title"]="Categories"; var descriptions=new[]{"Heating, ventilation, and cooling","Doors, windows, locks, and furniture","Lighting, outlets, and electrical faults","Water supply, drainage, and plumbing","Campus cleaning and sanitation"}; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATOR WORKSPACE</p><h1>Categories</h1><p class="page-intro">Organize maintenance requests using sample category records.</p></div><button class="btn btn-primary" type="button" data-category-add>Add category</button></div><div class="cc-alert cc-alert--warning mb-4" role="note"><svg class="cc-icon" aria-hidden="true"><use href="/img/campuscare/icons.svg#cc-exclamation-triangle"/></svg><div class="cc-alert__body">Sample previews only. Category changes are not saved or applied to tickets.</div></div>
<section class="cc-panel list-panel"><div class="panel-toolbar"><h2 class="cc-panel__title">Category management</h2><label class="search-box"><span class="cc-visually-hidden">Search categories</span><input type="search" placeholder="Search categories" data-table-search="categories-table"/></label></div><div class="cc-table-wrap"><table class="cc-table responsive-table" id="categories-table"><caption class="cc-visually-hidden">Sample ticket categories</caption><thead><tr><th>Category</th><th>Description</th><th>Tickets</th><th>Status</th><th>Actions</th></tr></thead><tbody>@for(var i=0;i<DemoData.Categories.Length;i++){var name=DemoData.Categories[i];var count=DemoData.Tickets.Count(t=>t.Category==name);<tr data-name="@name"><td data-label="Category"><strong>@name</strong></td><td data-label="Description">@descriptions[i]</td><td data-label="Tickets">@count sample</td><td data-label="Status">Active · sample</td><td data-label="Actions"><button class="btn btn-secondary btn-sm" type="button" data-edit-category="@name" data-description="@descriptions[i]">Edit preview</button> <button class="btn btn-link btn-sm danger-link" type="button" data-deactivate="@name">Deactivate preview</button></td></tr>}</tbody></table></div><div class="cc-empty" data-empty hidden><p class="cc-empty__title">No matching categories</p></div></section>
<dialog class="cc-dialog" id="category-dialog" aria-labelledby="category-dialog-title"><div class="dialog-head"><h2 id="category-dialog-title">Add sample category</h2><button type="button" class="icon-button" data-close-dialog aria-label="Close category form">×</button></div><div class="dialog-content"><form data-demo-form><div class="cc-field"><label class="form-label" for="category-name">Category name</label><input class="form-control" id="category-name" required maxlength="60"/></div><div class="cc-field"><label class="form-label" for="category-description">Description</label><textarea class="form-control" id="category-description" rows="3" maxlength="180"></textarea></div><div class="form-actions"><button class="btn btn-primary" type="submit">Preview category</button><button class="btn btn-secondary" type="button" data-cancel-dialog>Cancel</button></div></form></div></dialog>
<dialog class="cc-dialog" id="deactivate-dialog" aria-labelledby="deactivate-title"><div class="dialog-head"><h2 id="deactivate-title">Confirm category change</h2><button type="button" class="icon-button" data-close-dialog aria-label="Close confirmation">×</button></div><div class="dialog-content"><p data-deactivate-message></p><p class="cc-field__hint">This preview changes only the current page. Reloading restores the sample.</p><div class="form-actions"><button class="btn btn-danger" type="button" data-confirm-deactivate>Confirm preview</button><button class="btn btn-secondary" type="button" data-cancel-dialog>Cancel</button></div></div></dialog>

