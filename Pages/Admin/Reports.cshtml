@page "/Admin/Reports"
@using CampusCare.Frontend.SampleData
@{ var tickets=DemoData.Tickets; ViewData["Title"]="Reports"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATOR WORKSPACE</p><h1>Reports</h1><p class="page-intro">Sample metrics calculated from the five sample ticket records. Choose a submission-date window.</p></div><span class="data-badge">Illustrative aggregates</span></div>
<div class="cc-alert cc-alert--info mb-4" role="note"><svg class="cc-icon" aria-hidden="true"><use href="/img/campuscare/icons.svg#cc-info-circle"/></svg><div class="cc-alert__body">All values are derived from <strong>SampleData/DemoData.cs</strong>. The date window filters the report client-side. The SLA example uses a documented 48-hour demo threshold, not an operational policy.</div></div>
<section class="cc-panel filters-panel"><h2 class="cc-panel__title">Submission date range</h2><div class="report-filters"><label>From<input class="form-control" type="date" data-report-from/></label><label>To<input class="form-control" type="date" data-report-to/></label><button class="btn btn-secondary" type="button" data-report-clear>Clear dates</button><button class="btn btn-primary" type="button" data-export-csv>Export filtered CSV</button></div></section>
<div class="stats-grid report-stats" aria-label="Ticket counts"><article class="cc-panel stat-card"><span>Total tickets</span><strong data-report-total>@tickets.Length</strong></article>@foreach(var status in new[]{"Open","In progress","Resolved"}){<article class="cc-panel stat-card"><span>@status</span><strong data-status-count="@status">@tickets.Count(t=>t.Status==status)</strong></article>}</div>
<section class="cc-panel list-panel"><div class="panel-toolbar"><div><h2 class="cc-panel__title">Status distribution</h2><p class="cc-text-dense cc-text-muted mb-0">Counts in current date window</p></div></div><div class="chart-list report-status-list">@foreach(var status in DemoData.Statuses){var count=tickets.Count(t=>t.Status==status);<div class="chart-row report-record" data-kind="status" data-name="@status" data-count="@count"><span>@status</span><div class="bar-track"><span class="bar" style="width:@(tickets.Length==0?0:count*100/tickets.Length)%"></span></div><strong data-count-cell>@count</strong></div>}</div></section>
<div class="report-grid"><section class="cc-panel list-panel"><div class="panel-toolbar"><div><h2 class="cc-panel__title">Tickets by category</h2><p class="cc-text-dense cc-text-muted mb-0">Recomputed from sample tickets</p></div></div><div class="chart-list">@foreach(var category in DemoData.Categories){var count=tickets.Count(t=>t.Category==category);<div class="chart-row report-record" data-kind="category" data-name="@category" data-count="@count"><span>@category</span><div class="bar-track"><span class="bar" style="width:@(tickets.Length==0?0:count*100/tickets.Length)%"></span></div><strong data-count-cell>@count</strong></div>}</div><div class="cc-table-wrap"><table class="cc-table"><caption class="cc-visually-hidden">Sample ticket counts by category</caption><thead><tr><th>Category</th><th>Tickets</th></tr></thead><tbody>@foreach(var category in DemoData.Categories){<tr class="report-record" data-kind="category" data-name="@category" data-count="@tickets.Count(t=>t.Category==category)"><td>@category</td><td data-count-cell>@tickets.Count(t=>t.Category==category)</td></tr>}</tbody></table></div></section>
<section class="cc-panel list-panel"><div class="panel-toolbar"><div><h2 class="cc-panel__title">Agent comparison</h2><p class="cc-text-dense cc-text-muted mb-0">Assigned workload from sample tickets</p></div></div><div class="chart-list">@foreach(var agent in DemoData.Agents){var count=tickets.Count(t=>t.Agent==agent);<div class="chart-row report-record" data-kind="agent" data-name="@agent" data-count="@count"><span>@agent</span><div class="bar-track"><span class="bar bar-green" style="width:@(tickets.Length==0?0:count*100/tickets.Length)%"></span></div><strong data-count-cell>@count</strong></div>}</div><div class="cc-table-wrap"><table class="cc-table"><caption class="cc-visually-hidden">Sample assigned tickets by agent</caption><thead><tr><th>Agent</th><th>Tickets</th></tr></thead><tbody>@foreach(var agent in DemoData.Agents){<tr class="report-record" data-kind="agent" data-name="@agent" data-count="@tickets.Count(t=>t.Agent==agent)"><td>@agent</td><td data-count-cell>@tickets.Count(t=>t.Agent==agent)</td></tr>}</tbody></table></div></section></div>
<table class="report-source-table" data-export-source><caption>Sample records used in this report export</caption><thead><tr><th>Ticket</th><th>Subject</th><th>Category</th><th>Priority</th><th>Status</th><th>Assigned agent</th><th>Requester</th><th>Submitted on</th><th>Updated on</th><th>SLA due</th></tr></thead><tbody>@foreach(var t in tickets){<tr data-submitted-date="@t.SubmittedOn.ToString("yyyy-MM-dd")"><td>@t.Number</td><td>@t.Subject</td><td>@t.Category</td><td>@t.Priority</td><td>@t.Status</td><td>@t.Agent</td><td>@t.Requester</td><td>@DemoData.DisplayDate(t.SubmittedOn)</td><td>@DemoData.DisplayDate(t.UpdatedOn)</td><td>@DemoData.DisplayDate(t.SlaDueOn)</td></tr>}</tbody></table>


