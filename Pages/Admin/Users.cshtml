@page "/Admin/Users"
@using CampusCare.Frontend.SampleData
@{ ViewData["Title"]="Users"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATOR WORKSPACE</p><h1>Users</h1><p class="page-intro">Manage sample users and preview role changes.</p></div><button class="btn btn-primary" type="button" data-user-add>Add user</button></div>
<div class="cc-alert cc-alert--warning mb-4" role="note"><svg class="cc-icon" aria-hidden="true"><use href="/img/campuscare/icons.svg#cc-exclamation-triangle"/></svg><div class="cc-alert__body">Temporary sample previews only. User records, account state, and roles are not saved or enforced.</div></div>
<section class="cc-panel list-panel"><div class="panel-toolbar"><div><h2 class="cc-panel__title">User management</h2><p class="cc-text-dense cc-text-muted mb-0">@DemoData.Users.Length sample users</p></div><label class="search-box"><span class="cc-visually-hidden">Search users</span><input type="search" placeholder="Search name or email" data-table-search="users-table"/></label></div><div class="cc-table-wrap"><table class="cc-table responsive-table" id="users-table"><caption class="cc-visually-hidden">Sample user management records</caption><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Account state</th><th>Actions</th></tr></thead><tbody>@foreach(var u in DemoData.Users){<tr data-name="@u.Name"><td data-label="Name"><span class="cc-person"><span class="cc-avatar">@u.Name.Split(' ').Select(x=>x[0]).First()@u.Name.Split(' ').Last()[0]</span><strong>@u.Name</strong></span></td><td data-label="Email">@u.Email</td><td data-label="Role"><span class="role-chip">@u.Role</span></td><td data-label="Account state"><span class="state-dot">@u.State · sample</span></td><td data-label="Actions"><button class="btn btn-secondary btn-sm" type="button" data-edit-user="@u.Name" data-role="@u.Role" data-email="@u.Email">Edit preview</button></td></tr>}</tbody></table></div><div class="cc-empty" data-empty hidden><p class="cc-empty__title">No matching users</p><p class="cc-empty__hint">Try a different search.</p></div></section>
<dialog class="cc-dialog" id="user-dialog" aria-labelledby="user-dialog-title"><div class="dialog-head"><h2 id="user-dialog-title">Add sample user</h2><button type="button" class="icon-button" data-close-dialog aria-label="Close user form">×</button></div><div class="dialog-content"><form data-demo-form><div class="cc-field"><label class="form-label" for="user-name">Name</label><input class="form-control" id="user-name" required maxlength="100"/></div><div class="cc-field"><label class="form-label" for="user-email">Email</label><input class="form-control" id="user-email" type="email" required maxlength="160"/></div><div class="cc-field"><label class="form-label" for="user-role">Role</label><select class="form-select" id="user-role">@foreach(var role in DemoData.Roles){<option>@role</option>}</select><div class="cc-field__hint">Role is a sample display value only.</div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Preview user</button><button class="btn btn-secondary" type="button" data-cancel-dialog>Cancel</button></div></form></div></dialog>
