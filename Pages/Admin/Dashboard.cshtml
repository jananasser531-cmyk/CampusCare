@page "/Admin/Dashboard"
@using CampusCare.Frontend.SampleData
@{ var t=DemoData.Tickets; var overdue=t.Count(x=>x.Status!="Resolved"&&x.Status!="Closed"&&x.SlaDueOn<DateTime.UtcNow); ViewData["Title"]="Admin Dashboard"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATOR WORKSPACE</p><h1>Dashboard</h1><p class="page-intro">Snapshot derived from current sample tickets.</p></div><span class="data-badge">Sample summary</span></div>
<div class="cc-alert cc-alert--warning mb-4" role="note"><svg class="cc-icon" aria-hidden="true"><use href="/img/campuscare/icons.svg#cc-exclamation-triangle"/></svg><div class="cc-alert__body">Overdue count uses the documented illustrative 48-hour SLA threshold; it is not a real SLA policy.</div></div>
<section class="stats-grid" aria-label="Dashboard summary"><article class="cc-panel stat-card"><span>Total sample tickets</span><strong>@t.Length</strong></article><article class="cc-panel stat-card"><span>Open</span><strong>@t.Count(x=>x.Status=="Open")</strong></article><article class="cc-panel stat-card"><span>In progress</span><strong>@t.Count(x=>x.Status=="In progress")</strong></article><article class="cc-panel stat-card"><span>Resolved</span><strong>@t.Count(x=>x.Status=="Resolved")</strong></article><article class="cc-panel stat-card overdue"><span>Overdue by sample threshold</span><strong>@overdue</strong></article></section>
<div class="report-grid"><section class="cc-panel list-panel"><div class="panel-toolbar"><h2 class="cc-panel__title">Sample ticket trend</h2></div><div class="chart-list">@foreach(var day in t.GroupBy(x=>x.SubmittedOn.Date).OrderBy(x=>x.Key)){<div class="chart-row"><span>@day.Key.ToString("dd MMM")</span><div class="bar-track"><span class="bar" style="width:@(day.Count()*20)%"></span></div><strong>@day.Count()</strong></div>}</div></section><section class="cc-panel list-panel"><div class="panel-toolbar"><h2 class="cc-panel__title">Recent sample activity</h2></div><ol class="activity-timeline compact-timeline">@foreach(var item in DemoData.Activity.Values.SelectMany(x=>x).OrderByDescending(x=>x.At).Take(4)){<li class="activity-entry"><span class="activity-marker" aria-hidden="true"></span><div><div class="activity-meta"><strong>@item.Kind</strong><time>@DemoData.DisplayDate(item.At)</time></div><p>@item.Text</p></div></li>}</ol></section></div>
