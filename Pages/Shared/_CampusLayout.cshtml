@using CampusCare.Frontend.SampleData
@{ var current=Context.Request.Path.Value??""; var isAdmin=current.StartsWith("/Admin",StringComparison.OrdinalIgnoreCase); var role=isAdmin?"Administrator":"SupportAgent"; var icons=Url.Content("~/img/campuscare/icons.svg"); var unread=DemoData.Notifications.Count(n=>!n.IsRead); }
<!doctype html><html lang="en" data-cc-icons="@icons"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · CampusCare</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/campuscare/campuscare.css"/><link rel="stylesheet" href="~/css/app.css"/></head><body>
<a class="cc-skip-link" href="#main">Skip to main content</a>
<header class="topbar"><button class="mobile-menu" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-toggle><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-list"/></svg></button><a class="brand" href="/Agent/AssignedTickets"><span class="brand-mark">C</span><span>CampusCare</span></a><div class="role-label">@role <span class="sample-pill">Sample UI</span></div><div class="notification-wrap"><button class="notification-trigger" type="button" aria-expanded="false" aria-controls="notification-panel" aria-label="Notifications, @unread unread" data-notification-toggle><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-bell"/></svg>@if(unread>0){<span class="notification-count" data-unread-count>@unread</span>}</button><section class="notification-panel" id="notification-panel" hidden aria-label="Notifications"><h2>Notifications <span class="cc-text-caption cc-text-muted">Sample only</span></h2>@foreach(var n in DemoData.Notifications.OrderByDescending(x=>x.At)){<article class="notification-item @(n.IsRead?"":"unread")" data-notification="@n.Id"><a href="/Agent/UpdateTicket?ticket=@n.TicketNumber"><strong>@n.Category</strong><span>@n.Text</span><small>@DemoData.DisplayDate(n.At) · @n.TicketNumber</small></a><button class="btn btn-link btn-sm" type="button" data-toggle-read aria-pressed="@n.IsRead">Mark @(n.IsRead?"unread":"read")</button></article>}</section></div></header>
<aside class="sidebar" data-sidebar><div class="sidebar-label">@role workspace</div><nav aria-label="Main navigation">@if(isAdmin){<a class="side-link @(current.StartsWith("/Admin/Dashboard")?"active":"")" href="/Admin/Dashboard"><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-grid"/></svg>Dashboard</a><a class="side-link @(current.StartsWith("/Admin/Tickets")?"active":"")" href="/Admin/Tickets"><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-ticket"/></svg>Tickets</a><a class="side-link @(current.StartsWith("/Admin/Users")?"active":"")" href="/Admin/Users"><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-people"/></svg>Users</a><a class="side-link @(current.StartsWith("/Admin/Categories")?"active":"")" href="/Admin/Categories"><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-tag"/></svg>Categories</a><a class="side-link @(current.StartsWith("/Admin/Reports")?"active":"")" href="/Admin/Reports"><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-file"/></svg>Reports</a>}else{<a class="side-link @(current.StartsWith("/Agent/AssignedTickets")?"active":"")" href="/Agent/AssignedTickets"><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-ticket"/></svg>Assigned Tickets</a><a class="side-link @(current.StartsWith("/Agent/UpdateTicket")?"active":"")" href="/Agent/UpdateTicket"><svg class="cc-icon" aria-hidden="true"><use href="@icons#cc-pencil"/></svg>Update Ticket</a>}<div class="nav-role-switch"><span>Preview role</span><a href="/Agent/AssignedTickets">SupportAgent view</a><a href="/Admin/Dashboard">Administrator view</a></div></nav><div class="sidebar-foot"><span class="cc-avatar">@(isAdmin?"AD":"SA")</span><span><strong>@(isAdmin?"Mina Adel":DemoData.SampleAgent)</strong><small>@role · sample</small></span></div></aside>
<main id="main" class="main-content">@RenderBody()<footer class="app-footer">CampusCare · Frontend sample data — changes are temporary previews, not saved.</footer></main><div class="sidebar-scrim" data-scrim hidden></div><div id="cc-toast-region" class="cc-toast-region" aria-live="polite"></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/campuscare/cc-core.js"></script><script src="~/js/app.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
